{
  "format": 1,
  "id": "usgs-water-idaho",
  "title": "River flow and gage height, Idaho (USGS)",
  "provider": "USGS Water Services",
  "description": "latest river discharge (cfs) and gage height (ft) at active USGS stream gages in Idaho; the same list for every place (USGS)",
  "attribution": "Water data from the US Geological Survey (waterservices.usgs.gov), public domain; provisional data is subject to revision",
  "request": {
    "url": "https://waterservices.usgs.gov/nwis/iv/?format=json&stateCd=ID&parameterCd=00060,00065&siteStatus=active&siteType=ST"
  },
  "refresh_minutes": 30,
  "quota": { "per_minute": 10, "per_day": 500, "per_month": 10000 },
  "validity": { "fixed_hours": 3 },
  "require": ["value.timeSeries"],
  "items": [
    {
      "each": "value.timeSeries",
      "key": { "path": "name" },
      "label": { "template": "{site}", "vars": { "site": { "path": "sourceInfo.siteName" } } },
      "time": { "path": "values[0].value[-1].dateTime", "time": { "in": "rfc3339", "zone": "place", "out": "datetime" } },
      "point": { "lat": { "path": "sourceInfo.geoLocation.geogLocation.latitude" }, "lon": { "path": "sourceInfo.geoLocation.geogLocation.longitude" } },
      "fields": [
        { "label": "Measurement", "path": "variable.variableDescription" },
        { "label": "Latest reading", "template": "{v} {u}", "vars": { "v": { "path": "values[0].value[-1].value", "omit_if": ["-999999", "-999999.0"] }, "u": { "path": "variable.unit.unitCode", "lookup": { "ft3/s": "cfs", "ft": "ft" } } } },
        { "label": "Site number", "path": "sourceInfo.siteCode[0].value" },
        { "label": "Data status", "path": "values[0].value[-1].qualifiers", "lookup": { "P": "provisional", "A": "approved", "*": "see USGS" } }
      ]
    }
  ]
}
