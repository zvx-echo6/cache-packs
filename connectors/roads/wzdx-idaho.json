{
  "format": 1,
  "id": "wzdx-idaho",
  "title": "Road work zones, Idaho (WZDx)",
  "provider": "Idaho Transportation Department",
  "description": "statewide Idaho road work zones and lane closures from the national WZDx feed, most restrictive first; the same list for every place",
  "attribution": "Work zone data from the Idaho Transportation Department (511.idaho.gov) in the USDOT WZDx format",
  "request": { "url": "https://511.idaho.gov/api/wzdx" },
  "refresh_minutes": 30,
  "quota": { "per_minute": 4, "per_day": 200, "per_month": 3000 },
  "validity": { "fixed_hours": 6 },
  "require": ["features"],
  "items": [
    {
      "each": "features",
      "key": { "path": "id" },
      "label": { "template": "{road} {dir}", "vars": { "road": { "path": "properties.core_details.road_names" }, "dir": { "path": "properties.core_details.direction", "omit_if": ["unknown", "undefined"] } } },
      "time": { "path": "properties.core_details.update_date", "time": { "in": "rfc3339", "zone": "place", "out": "datetime" } },
      "ends": { "path": "properties.end_date", "time": { "in": "rfc3339" } },
      "sort": [
        { "by": { "path": "properties.vehicle_impact" }, "rank": ["all-lanes-closed", "some-lanes-closed", "alternating-one-way", "some-lanes-closed-merge-left", "some-lanes-closed-merge-right", "flagging", "temporary-traffic-signal", "all-lanes-open-shift-left", "all-lanes-open-shift-right", "all-lanes-open"] }
      ],
      "point": { "lat": { "path": "geometry.coordinates[0][1]" }, "lon": { "path": "geometry.coordinates[0][0]" } },
      "fields": [
        { "label": "Type", "path": "properties.core_details.event_type" },
        { "label": "Lanes", "path": "properties.vehicle_impact" },
        { "label": "Cross street", "path": "properties.beginning_cross_street" },
        { "label": "Starts", "path": "properties.start_date", "time": { "in": "rfc3339", "zone": "place", "out": "%Y-%m-%d %H:%M" } },
        { "label": "Ends", "path": "properties.end_date", "time": { "in": "rfc3339", "zone": "place", "out": "%Y-%m-%d %H:%M" } },
        { "label": "Speed limit in zone", "path": "properties.reduced_speed_limit_kph", "scale": 0.621371, "round": 0, "suffix": " mph" },
        { "label": "Details", "path": "properties.core_details.description", "max_chars": 300 }
      ]
    }
  ]
}
